# Google Sheets API Configuration
# Copy this file to .env and fill in your actual values

REACT_APP_GOOGLE_SHEETS_ID=your_sheet_id_here
REACT_APP_GOOGLE_API_KEY=your_api_key_here

# --- Blog (Neon + admin) --- set these in Vercel -> Settings -> Environment Variables
# and in .env.local for `vercel dev`. Never prefix with REACT_APP_ (that would expose them in the browser).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
ADMIN_PASSWORD=choose_a_long_unique_password
ADMIN_TOKEN_SECRET=at_least_32_random_characters
BLOB_READ_WRITE_TOKEN=added_automatically_when_you_create_a_Vercel_Blob_store
SITE_URL=https://www.kalpvrikshglobal.com
